# Copy this file to .env and fill in real values before running in production.

# Port the server listens on.
PORT=3000

# Secret used to sign login tokens. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# How long a login stays valid before someone has to sign in again.
JWT_EXPIRES_IN=30d

# Where the SQLite database file is stored.
DATABASE_FILE=./data/quadrant.db

# The very first admin account, created automatically the first time the
# server starts with an empty database. Change the password after first login.
ADMIN_NAME=Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
